@mode(host.dual)

# Unit tests for todo's exit statuses (cli.app.run on whole command lines).
# These tests print the program's normal output and error messages; none
# of them writes a file.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_USAGE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_OK, "--help");
    expectEq(run(["help"]), EXIT_OK, "help command");
}

func test_list_of_missing_file_succeeds(): void {
    expectEq(run(["list", "--file", "/nonexistent-dir/todo.json"]), EXIT_OK, "no file, no tasks");
}

func test_usage_errors(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_USAGE, "no command");
    expectEq(run(["bogus"]), EXIT_USAGE, "unknown command");
    expectEq(run(["list", "--bogus"]), EXIT_USAGE, "unknown option");
    expectEq(run(["rm", "1", "--all"]), EXIT_USAGE, "option for another command");
    expectEq(run(["done", "--file", "/nonexistent-dir/todo.json"]), EXIT_USAGE, "missing ID");
}
