@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, disallowed);

func test_no_arguments(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.command, "", "no command");
    expectEq(opts.operands.len(), 0, "no operands");
    expect(!opts.help and !opts.version and !opts.all, "no flags set");
}

func test_command_and_operands(): void {
    let opts = parse_args(["add", "buy", "milk"]).unwrap();
    expectEq(opts.command, "add", "command");
    expectEq(opts.operands.len(), 2, "two words");
    expectEq(opts.operands[1], "milk", "operand");
}

func test_options_anywhere(): void {
    let opts = parse_args(["add", "-p", "high", "buy", "--tag", "home", "milk", "-t", "x"]).unwrap();
    expectEq(opts.priority, "high", "priority");
    expectEq(opts.tags.len(), 2, "two tags");
    expectEq(opts.tags[1], "x", "second tag");
    expectEq(opts.operands.join(" "), "buy milk", "text");
}

func test_inline_values(): void {
    let opts = parse_args(["--file=t.json", "edit", "3", "--due=today", "--untag=old"]).unwrap();
    expectEq(opts.file, "t.json", "--file=");
    expectEq(opts.due, "today", "--due=");
    expectEq(opts.untags[0], "old", "--untag=");
}

func test_flags(): void {
    let opts = parse_args(["list", "-a", "--overdue", "-l", "-s", "Milk"]).unwrap();
    expect(opts.all and opts.overdue and opts.long, "flags");
    expectEq(opts.search, "Milk", "search");
    expect(parse_args(["list", "--done"]).unwrap().done_only, "--done");
}

func test_given_records_long_names(): void {
    let opts = parse_args(["add", "x", "-p", "h", "-d", "today"]).unwrap();
    expect(opts.given.contains("--priority") and opts.given.contains("--due"), "given");
}

func test_double_dash(): void {
    let opts = parse_args(["add", "--", "-p", "is", "text"]).unwrap();
    expectEq(opts.priority, "", "no priority");
    expectEq(opts.operands.join(" "), "-p is text", "operands");
}

func test_help_and_version(): void {
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["-h"]).unwrap().help, "-h");
    expect(parse_args(["--version"]).unwrap().version, "--version");
    expect(parse_args(["-V"]).unwrap().version, "-V");
}

func test_errors(): void {
    expectEq(parse_args(["-x"]).unwrap_err(), "unknown option '-x'", "unknown");
    expectEq(parse_args(["add", "-p"]).unwrap_err(), "option '-p' requires a value", "missing value");
    expectEq(parse_args(["--all=1"]).unwrap_err(), "option '--all' does not take a value", "flag value");
}

func test_disallowed(): void {
    let opts = parse_args(["rm", "1", "-a", "--file", "x", "-p", "h"]).unwrap();
    let none: list[string] = [];
    let bad = disallowed(opts, none);
    expectEq(bad.len(), 2, "--all and --priority");
    expectEq(bad[0], "--all", "first");
    expectEq(disallowed(opts, ["--all", "--priority"]).len(), 0, "all allowed");
}
