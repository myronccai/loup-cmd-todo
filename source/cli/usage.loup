@mode(host.dual)

# todo: the --help text and the --version line.
#
# Runtime: host.dual. Compiled into the native binary build/todo by `make
# build`; `loup run source/main.loup` interprets the same code, and CI runs
# the end-to-end tests in both lanes.

from appinfo import (APP_NAME, APP_VERSION);

pub func usage(): string {
    let lines = [
        "usage: " + APP_NAME + " [OPTION]... COMMAND [ARG]...",
        "",
        "Keep a list of tasks in a JSON file: --file FILE, else $TODO_FILE, else",
        "./todo.json.",
        "",
        "Commands:",
        "  add TEXT...      add a task              [-p PRIORITY] [-t TAG]... [-d DATE]",
        "  list             list open tasks         [-a | --done] [-t TAG]... [-p PRIORITY]",
        "                                           [-s TEXT] [--overdue] [-l]",
        "  done ID...       mark tasks done",
        "  undo ID...       mark tasks not done",
        "  rm ID...         remove tasks",
        "  edit ID [TEXT]   change a task           [-p PRIORITY] [-t TAG]... [--untag TAG]...",
        "                                           [-d DATE]",
        "  due [DAYS]       open tasks due within DAYS days (default 7), overdue",
        "                   ones included           [-t TAG]... [-p PRIORITY] [-l]",
        "  help             show this help",
        "",
        "Options:",
        "  -f, --file FILE      the todo file",
        "  -p, --priority P     high, medium, low (h, m, l) or none",
        "  -t, --tag TAG        add a tag; with list and due, show tasks that have it",
        "      --untag TAG      remove a tag (edit)",
        "  -d, --due DATE       YYYY-MM-DD, today, tomorrow, +N (days), +Nw (weeks),",
        "                       a weekday (the next one) or none",
        "  -a, --all            list done tasks too",
        "      --done           list only done tasks",
        "  -s, --search TEXT    list tasks whose text contains TEXT (any case)",
        "      --overdue        list only open tasks past their due date",
        "  -l, --long           also show created and completed dates and the UUID",
        "  -h, --help           display this help and exit",
        "  -V, --version        output version information and exit",
        "",
        "Exit status: 0 on success, 1 if a task or the file could not be used,",
        "2 on a usage error.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return APP_NAME + " (loup-cmd-" + APP_NAME + ") " + APP_VERSION;
}
