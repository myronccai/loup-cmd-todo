@mode(host.dual)

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (Options, parse_args, disallowed);
from cli.usage import (usage, version_line);
from commands.runner import (allowed_options, run_command);

# Parses argv, runs the selected command and returns the exit status.
pub func run(argv: list[string]): int {
    let parsed = parse_args(argv);
    if (parsed.is_err()) {
        return usage_error(parsed.unwrap_err());
    }
    let opts = parsed.unwrap();

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return dispatch(opts);
    } catch (Exception as e) {
        printErr(APP_NAME + ": error: " + e.message);
        return EXIT_FAILURE;
    }
}

# Checks the command and its options, then runs it.
func dispatch(opts: Options): int {
    let command = opts.command;
    if (command.len() == 0) {
        return usage_error("no command given");
    }
    if (command == "help") {
        println(usage());
        return EXIT_OK;
    }
    let allowed = allowed_options(command);
    if (allowed.contains("?")) {
        return usage_error("unknown command '" + command + "'");
    }
    let bad = disallowed(opts, allowed);
    if (bad.len() > 0) {
        return usage_error("option '" + bad[0] + "' does not apply to '" + command + "'");
    }
    return run_command(opts);
}

func usage_error(msg: string): int {
    printErr(APP_NAME + ": " + msg);
    printErr("Try '" + APP_NAME + " --help' for more information.");
    return EXIT_USAGE;
}
