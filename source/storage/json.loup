@mode(host.dual)

# todo storage: a small JSON reader and writer for the todo file.
#
# Runtime: host.dual. Compiled into the native binary build/todo by `make
# build`; `loup run source/main.loup` interprets the same code, and CI runs
# the end-to-end tests in both lanes. system.json would do this, but its
# parse and stringify are host builtins that native builds of Loup 1.26.0
# cannot link, so todo carries its own.
#
# Objects keep their keys in order (two parallel lists, because native
# builds misread enum values stored in a dict). Numbers are integers: the
# todo file stores nothing else.
#
# Structure: the Json value; the reader, a recursive-descent parser whose
# Reader holds the input split into characters, the position and the first
# error (read_value picks a reader by the first character, and arrays and
# objects call it again for their elements); parse_json for a whole
# document; the writer (quote, write_json); field, the lookup that
# storage.file reads objects with.
#
# The reader is strict where the todo file needs it to be: a \u escape
# that is half of a UTF-16 surrogate pair is refused, since it stands for
# no character and could not be written back as UTF-8.

## A parsed JSON value.
pub enum Json {
    Null,
    Bool(value: bool),
    Int(value: int),
    Str(value: string),
    Arr(items: list[Json]),
    Obj(keys: list[string], values: list[Json]),
}

## The parser's state. The input is a list of one-character strings, so
## `pos` counts characters, as the error positions do.
pub struct Reader {
    pub chars: list[string];
    pub var pos: int;
    pub var error: string;
}

const HEX: string = "0123456789abcdef";
const DIGITS: string = "0123456789";
const WHITESPACE: string = " \t\r\n";

# The control characters U+0000 to U+001F, which must be escaped.
func control_chars(): list[string] {
    var chars: list[string] = [];
    var code = 0;
    while (code < 32) {
        chars.push(str(char.of(code)));
        code += 1;
    }
    return chars;
}

func at_end(r: Reader): bool {
    return r.pos >= r.chars.len();
}

func current(r: Reader): string {
    if (r.pos >= r.chars.len()) {
        return "";
    }
    return r.chars[r.pos];
}

func skip_ws(edits r: Reader): void {
    while (r.pos < r.chars.len() and WHITESPACE.index_of(r.chars[r.pos]) >= 0) {
        r.pos += 1;
    }
}

# Steps over `ch` when it is the current character; says whether it did.
func eat(edits r: Reader, ch: string): bool {
    if (current(r) == ch) {
        r.pos += 1;
        return true;
    }
    return false;
}

# Records the first error with its position and returns it.
func fail(edits r: Reader, message: string): string {
    if (r.error.len() == 0) {
        r.error = message + " at character " + str(r.pos + 1);
    }
    return r.error;
}

func read_hex4(edits r: Reader): int {
    var code = 0;
    var k = 0;
    while (k < 4) {
        let digit = HEX.index_of(current(r).toLowerCase());
        if (current(r).len() != 1 or digit < 0) {
            return -1;
        }
        code = code * 16 + digit;
        r.pos += 1;
        k += 1;
    }
    return code;
}

# Each reader below is entered with `r.pos` on the first character of its
# value (read_value skips whitespace to get there) and leaves it just past
# the value. An Err carries the message `fail` recorded, which `?` passes
# up unchanged.

# A string literal, its escapes decoded.
func read_string(edits r: Reader): Result[string, string] {
    r.pos += 1;
    let controls = control_chars();
    var parts: list[string] = [];
    while (!at_end(r)) {
        let ch = r.chars[r.pos];
        r.pos += 1;
        if (ch == "\"") {
            return Ok(parts.join(""));
        }
        if (controls.contains(ch)) {
            return Err(fail(edits: r, "control character in string"));
        }
        if (ch != "\\") {
            parts.push(ch);
            continue;
        }
        let esc = current(r);
        r.pos += 1;
        if (esc == "\"" or esc == "\\" or esc == "/") {
            parts.push(esc);
        } else if (esc == "n") {
            parts.push("\n");
        } else if (esc == "t") {
            parts.push("\t");
        } else if (esc == "r") {
            parts.push("\r");
        } else if (esc == "b") {
            parts.push(str(char.of(8)));
        } else if (esc == "f") {
            parts.push(str(char.of(12)));
        } else if (esc == "u") {
            var code = read_hex4(edits: r);
            if (code < 0) {
                return Err(fail(edits: r, "bad \\u escape"));
            }
            # A surrogate pair, a high half (D800-DBFF) and then a low half
            # (DC00-DFFF), encodes one code point above U+FFFF. A low half
            # first, or a high half not followed by a low one, is an error.
            if (code >= 0xDC00 and code <= 0xDFFF) {
                return Err(fail(edits: r, "lone surrogate in \\u escape"));
            }
            if (code >= 0xD800 and code <= 0xDBFF) {
                if (!eat(edits: r, "\\") or !eat(edits: r, "u")) {
                    return Err(fail(edits: r, "lone surrogate in \\u escape"));
                }
                let low = read_hex4(edits: r);
                if (low < 0) {
                    return Err(fail(edits: r, "bad \\u escape"));
                }
                if (low < 0xDC00 or low > 0xDFFF) {
                    return Err(fail(edits: r, "lone surrogate in \\u escape"));
                }
                code = 0x10000 + (code - 0xD800) * 0x400 + (low - 0xDC00);
            }
            parts.push(str(char.of(code)));
        } else {
            return Err(fail(edits: r, "bad escape"));
        }
    }
    return Err(fail(edits: r, "unterminated string"));
}

# An optional `-` and digits; a fraction or exponent is refused.
func read_number(edits r: Reader): Result[Json, string] {
    var negative = false;
    if (current(r) == "-") {
        negative = true;
        r.pos += 1;
    }
    var value = 0;
    var digits = 0;
    while (!at_end(r) and current(r).len() == 1 and DIGITS.index_of(current(r)) >= 0) {
        value = value * 10 + DIGITS.index_of(current(r));
        r.pos += 1;
        digits += 1;
    }
    if (digits == 0) {
        return Err(fail(edits: r, "unexpected character"));
    }
    if (current(r) == "." or current(r) == "e" or current(r) == "E") {
        return Err(fail(edits: r, "only whole numbers are supported"));
    }
    if (negative) {
        value = 0 - value;
    }
    return Ok(Json.Int(value = value));
}

# true, false or null; anything else is an error.
func read_word(edits r: Reader): Result[Json, string] {
    var j = r.pos;
    while (j < r.chars.len() and "abcdefghijklmnopqrstuvwxyz".index_of(r.chars[j]) >= 0) {
        j += 1;
    }
    let word = r.chars.slice(r.pos, j).join("");
    if (word == "true") {
        r.pos = j;
        return Ok(Json.Bool(value = true));
    }
    if (word == "false") {
        r.pos = j;
        return Ok(Json.Bool(value = false));
    }
    if (word == "null") {
        r.pos = j;
        return Ok(Json.Null);
    }
    return Err(fail(edits: r, "unexpected character"));
}

# Arrays and objects: after the opening bracket, either the closing one
# at once, or elements separated by commas and then the closing bracket.
# The element loop is a do/while: there is at least one element, and a
# comma after it asks for another; anything else must be the bracket.
func read_array(edits r: Reader): Result[Json, string] {
    r.pos += 1;
    var items: list[Json] = [];
    skip_ws(edits: r);
    if (eat(edits: r, "]")) {
        return Ok(Json.Arr(items = items));
    }
    do {
        let item = read_value(edits: r)?;
        items.push(item);
        skip_ws(edits: r);
    } while (eat(edits: r, ","));
    if (!eat(edits: r, "]")) {
        return Err(fail(edits: r, "expected ',' or ']'"));
    }
    return Ok(Json.Arr(items = items));
}

func read_object(edits r: Reader): Result[Json, string] {
    r.pos += 1;
    var keys: list[string] = [];
    var values: list[Json] = [];
    skip_ws(edits: r);
    if (eat(edits: r, "}")) {
        return Ok(Json.Obj(keys = keys, values = values));
    }
    do {
        skip_ws(edits: r);
        if (current(r) != "\"") {
            return Err(fail(edits: r, "expected a string key"));
        }
        let key = read_string(edits: r)?;
        skip_ws(edits: r);
        if (!eat(edits: r, ":")) {
            return Err(fail(edits: r, "expected ':'"));
        }
        let value = read_value(edits: r)?;
        keys.push(key);
        values.push(value);
        skip_ws(edits: r);
    } while (eat(edits: r, ","));
    if (!eat(edits: r, "}")) {
        return Err(fail(edits: r, "expected ',' or '}'"));
    }
    return Ok(Json.Obj(keys = keys, values = values));
}

## Any value, after optional whitespace, by its first character.
pub func read_value(edits r: Reader): Result[Json, string] {
    skip_ws(edits: r);
    if (at_end(r)) {
        return Err(fail(edits: r, "unexpected end of input"));
    }
    let ch = current(r);
    if (ch == "\"") {
        let text = read_string(edits: r)?;
        return Ok(Json.Str(value = text));
    }
    if (ch == "[") {
        return read_array(edits: r);
    }
    if (ch == "{") {
        return read_object(edits: r);
    }
    if (ch == "-" or DIGITS.index_of(ch) >= 0) {
        return read_number(edits: r);
    }
    return read_word(edits: r);
}

## Parses a whole JSON document; an Err names the first problem and the
## character it was found at.
pub func parse_json(text: string): Result[Json, string] {
    var chars: list[string] = [];
    for (ch in text) {
        chars.push(ch);
    }
    var r = Reader(chars = chars, pos = 0, error = "");
    let value = read_value(edits: r)?;
    skip_ws(edits: r);
    if (!at_end(r)) {
        return Err(fail(edits: r, "unexpected text after the value"));
    }
    return Ok(value);
}

## A JSON string literal for `text`.
pub func quote(text: string): string {
    let controls = control_chars();
    var parts: list[string] = ["\""];
    for (ch in text) {
        if (ch == "\"") {
            parts.push("\\\"");
        } else if (ch == "\\") {
            parts.push("\\\\");
        } else if (ch == "\n") {
            parts.push("\\n");
        } else if (ch == "\t") {
            parts.push("\\t");
        } else if (ch == "\r") {
            parts.push("\\r");
        } else if (controls.contains(ch)) {
            let code = controls.index_of(ch);
            parts.push("\\u00" + HEX.slice(code / 16, code / 16 + 1) + HEX.slice(code % 16, code % 16 + 1));
        } else {
            parts.push(ch);
        }
    }
    parts.push("\"");
    return parts.join("");
}

## Pretty-printed JSON, two spaces per level; empty arrays and objects and
## arrays of scalars stay on one line.
pub func write_json(value: Json, indent: string): string {
    match value {
        Json.Null => {
            return "null";
        },
        Json.Bool(b) => {
            if (b) {
                return "true";
            }
            return "false";
        },
        Json.Int(n) => {
            return str(n);
        },
        Json.Str(text) => {
            return quote(text);
        },
        Json.Arr(items) => {
            if (items.len() == 0) {
                return "[]";
            }
            var parts: list[string] = [];
            var flat = true;
            for (item in items) {
                if (is_container(item)) {
                    flat = false;
                }
                parts.push(write_json(item, indent + "  "));
            }
            if (flat) {
                return "[" + parts.join(", ") + "]";
            }
            return "[\n" + indent + "  " + parts.join(",\n" + indent + "  ") + "\n" + indent + "]";
        },
        Json.Obj(keys, values) => {
            if (keys.len() == 0) {
                return "{}";
            }
            var parts: list[string] = [];
            var i = 0;
            while (i < keys.len()) {
                parts.push(quote(keys[i]) + ": " + write_json(values[i], indent + "  "));
                i += 1;
            }
            return "{\n" + indent + "  " + parts.join(",\n" + indent + "  ") + "\n" + indent + "}";
        },
    }
}

func is_container(value: Json): bool {
    match value {
        Json.Arr(items) => {
            return true;
        },
        Json.Obj(keys, values) => {
            return true;
        },
        _ => {
            return false;
        },
    }
}

## The value of `key` in an object, and whether it was there.
pub struct Field {
    pub found: bool;
    pub value: Json;
}

## Looks `key` up in an object; anything but an object has no fields.
pub func field(obj: Json, key: string): Field {
    match obj {
        Json.Obj(keys, values) => {
            let i = keys.index_of(key);
            if (i >= 0) {
                return Field(found = true, value = values[i]);
            }
            return Field(found = false, value = Json.Null);
        },
        _ => {
            return Field(found = false, value = Json.Null);
        },
    }
}
