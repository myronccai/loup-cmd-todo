@mode(host.dual)

# todo: application identity and exit statuses. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Compiled into the native binary build/todo by `make
# build`; `loup run source/main.loup` interprets the same code, and CI runs
# the end-to-end tests in both lanes.

pub const APP_NAME: string = "todo";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "A task manager that keeps its tasks in a JSON file.";

# Exit statuses returned by main().
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 2;
